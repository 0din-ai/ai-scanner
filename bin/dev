#!/usr/bin/env sh

if ! command -v foreman >/dev/null 2>&1; then
  echo 'Foreman is missing. Run `gem install foreman` in a shell without injected credentials, then retry bin/dev.' >&2
  exit 1
fi

# Default to port 80 if not specified
export PORT="${ENV_PORT:-${PORT:-80}}"

exec foreman start -f Procfile.dev --env /dev/null "$@"
